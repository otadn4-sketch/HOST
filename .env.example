# =============================================================================
# سامانه اشتراک‌گذاری امن فایل و گزارش ایتان — نمونه متغیرهای محیطی
# این فایل را به .env کپی کنید و مقادیر را روی سرور تنظیم نمایید.
# هیچ رمز یا کلید واقعی را در مخزن کد قرار ندهید.
# =============================================================================

# production | development
EYTAN_ENV=production

# دامنه عمومی سامانه (بدون طرح). نمونه: files.example.ir
PUBLIC_HOST=localhost
PUBLIC_ORIGIN=https://localhost

# اگر گواهی واقعی ندارید، bootstrap گواهی خودامضا می‌سازد (فقط برای آزمایش).
TLS_CERT_PATH=/etc/nginx/certs/fullchain.pem
TLS_KEY_PATH=/etc/nginx/certs/privkey.pem

# PostgreSQL — رمز را با ژنراتور امن بسازید (scripts/bootstrap.sh این کار را می‌کند)
POSTGRES_DB=eytan
POSTGRES_USER=eytan
POSTGRES_PASSWORD=change-me-with-a-long-random-value
DATABASE_URL=postgresql+psycopg://eytan:change-me-with-a-long-random-value@db:5432/eytan

# کلید امضای کوکی نشست (حداقل ۳۲ بایت تصادفی)
SESSION_SECRET=change-me-with-a-long-random-value

# محدودیت حجم بارگذاری در Nginx و بک‌اند (باید با سیاست سامانه هماهنگ باشد)
CLIENT_MAX_BODY_SIZE=64m
DEFAULT_MAX_FILE_SIZE_BYTES=52428800

# مسیرهای ذخیره‌سازی داخل کانتینر (volume محلی، خارج از web root)
VAULT_PATH=/var/lib/eytan/vault
QUARANTINE_PATH=/var/lib/eytan/quarantine
BACKUP_PATH=/var/lib/eytan/backups
RELEASES_PATH=/var/lib/eytan/releases
STAGING_PATH=/var/lib/eytan/staging

# ClamAV
CLAMD_HOST=clamav
CLAMD_PORT=3310
SCAN_FAIL_CLOSED=true

# به‌روزرسانی: فقط کلید عمومی Ed25519 روی سرور باشد (hex یا base64)
UPDATE_PUBLIC_KEY=
UPDATE_AGENT_TOKEN=change-me-with-a-long-random-value
UPDATE_AGENT_URL=http://update-agent:8787

# رمزنگاری نسخه‌های پشتیبان (۳۲ بایت hex). جدا از رمز پایگاه‌داده نگهداری شود.
BACKUP_ENCRYPTION_KEY=change-me-64-hex-chars

# داده نمونه فقط برای development. در production باید false باشد.
EYTAN_SEED_DEV=false

# در development می‌توانید چهار کاربر نقش‌دار بسازید. رمزها را خودتان بگذارید.
# در production این مقادیر را خالی بگذارید.
DEV_ADMIN_PASSWORD=
DEV_GROUP_ADMIN_PASSWORD=
DEV_USER_PASSWORD=
DEV_VIEWER_PASSWORD=

# CORS: فقط origin واقعی سامانه
CORS_ORIGINS=https://localhost
