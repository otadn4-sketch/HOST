APP_NAME=Eytan Secure File Sharing
APP_ENV=production
APP_VERSION=1.1.0
SECRET_KEY=change-me-in-production
DATABASE_URL=postgresql+psycopg://eytan:eytan@localhost:5432/eytan
REDIS_URL=redis://localhost:6379/0
VAULT_ROOT=/var/lib/eytan/vault
QUARANTINE_ROOT=/var/lib/eytan/quarantine
LOG_ROOT=/var/lib/eytan/logs
SESSION_COOKIE_NAME=eytan_session
SESSION_TTL_MINUTES=480
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_PASSWORD=ChangeMe_Admin_123!
CLAMAV_SOCKET=/var/run/clamav/clamd.ctl
UPDATE_PUBLIC_KEY=
UPDATE_AGENT_TOKEN=
CORS_ORIGINS=https://files.local
# Optional off-box AI (leave empty to keep the local on-prem fallback):
# Do not commit live keys. Configure only on the Windows Server host.

# Manual logging / Faran (no live network by default)
AUTOMATED_DELIVERY_ENABLED=false
PHASE_1_ARCHIVE_ENABLED=true
PHASE_2_MEETINGS_ENABLED=true
PHASE_3_RECIPIENT_PROFILES_ENABLED=true
PHASE_4_SHARING_ENABLED=false
PHASE_5_SECURITY_GRAPH_ENABLED=false
FARAN_ENABLED=false
FARAN_BASE_URL=
FARAN_API_TOKEN=
FARAN_ALLOW_NETWORK=false
