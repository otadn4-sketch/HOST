# Copy to `.env` and replace every `change-me-*` placeholder before production use.
# `./scripts/bootstrap.sh` copies this file (if `.env` is missing) and fills the
# placeholders listed below with random values. Never commit a filled `.env`.
#
# This sample file contains no usable secrets, passwords, API keys, or accounts.
# Production refuses to start if placeholders or empty SESSION_SECRET / DATABASE_URL
# / BACKUP_ENCRYPTION_KEY remain.
#
# Product rule: SMS and automated outbound delivery stay OFF in production
# until a new written decision is recorded. Manual interaction logging is separate.

EYTAN_ENV=production
PUBLIC_HOST=localhost
PUBLIC_ORIGIN=https://localhost
CORS_ORIGINS=https://localhost

POSTGRES_DB=eytan
POSTGRES_USER=eytan
POSTGRES_PASSWORD=change-me-with-a-long-random-value
DATABASE_URL=postgresql+psycopg://eytan:change-me-with-a-long-random-value@db:5432/eytan

SESSION_SECRET=change-me-with-a-long-random-value
SESSION_COOKIE_NAME=eytan_session
SESSION_SECURE_COOKIE=true

VAULT_PATH=/var/lib/eytan/vault
QUARANTINE_PATH=/var/lib/eytan/quarantine
BACKUP_PATH=/var/lib/eytan/backups
STAGING_PATH=/var/lib/eytan/staging
RELEASES_PATH=/var/lib/eytan/releases

CLAMD_HOST=clamav
CLAMD_PORT=3310
SCAN_FAIL_CLOSED=true
CLAMAV_DISABLED=false

UPDATE_PUBLIC_KEY=
UPDATE_AGENT_TOKEN=change-me-with-a-long-random-value
UPDATE_AGENT_URL=http://update-agent:8787
UPDATE_ALLOW_UNSIGNED=false
BACKUP_ENCRYPTION_KEY=change-me-64-hex-chars
# Optional copy target for encrypted backups. Leave empty if no external disk is mounted.
BACKUP_EXTERNAL_PATH=

CLIENT_MAX_BODY_SIZE=64m
TLS_CERT_PATH=/etc/nginx/certs/fullchain.pem
TLS_KEY_PATH=/etc/nginx/certs/privkey.pem

# First admin is created with ./scripts/create-admin.sh (interactive). No bootstrap password.
EYTAN_SEED_DEV=false
EYTAN_FORCE_IMAGE_SYNC=0

AUTOMATED_DELIVERY_ENABLED=false
SMS_ENABLED=false
SMS_BASE_URL=
SMS_API_KEY=
SMS_SENDER=
SMS_HTTP_METHOD=POST
SMS_CONTENT_TYPE=json
SMS_URL_TEMPLATE=
SMS_BODY_TEMPLATE=
SMS_AUTH_HEADER_NAME=
SMS_TIMEOUT_SECONDS=15

PHASE_1_ARCHIVE_ENABLED=true
PHASE_2_MEETINGS_ENABLED=true
PHASE_3_RECIPIENT_PROFILES_ENABLED=true
PHASE_4_SHARING_ENABLED=false
PHASE_5_SECURITY_GRAPH_ENABLED=false

FARAN_ENABLED=false
FARAN_BASE_URL=
FARAN_API_TOKEN=
FARAN_ALLOW_NETWORK=false
