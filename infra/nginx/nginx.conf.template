worker_processes auto;
error_log /var/log/nginx/error.log warn;
pid /tmp/nginx.pid;

events { worker_connections 1024; }

http {
    include       /etc/nginx/mime.types;
    default_type  application/octet-stream;
    sendfile      on;
    server_tokens off;
    client_max_body_size ${CLIENT_MAX_BODY_SIZE};

    resolver 127.0.0.11 ipv6=off valid=10s;
    resolver_timeout 5s;

    proxy_hide_header Server;
    proxy_hide_header X-Powered-By;

    # Cloudflare / reverse-proxy tunnels send X-Forwarded-Proto=https while
    # the origin connection here is HTTP. Fall back to the local scheme.
    map $http_x_forwarded_proto $forwarded_proto {
        default $scheme;
        "~*^https" https;
        "~*^http"  http;
    }

    # HTTP is served (not redirected) so a temporary internet tunnel can
    # target http://127.0.0.1:80. HTTPS remains available on 443.
    server {
        listen 80 default_server;
        server_name ${PUBLIC_HOST};
        include /etc/nginx/app_locations.conf;
    }

    server {
        listen 443 ssl default_server;
        http2 on;
        server_name ${PUBLIC_HOST};

        ssl_certificate     ${TLS_CERT_PATH};
        ssl_certificate_key ${TLS_KEY_PATH};
        ssl_protocols       TLSv1.2 TLSv1.3;
        ssl_prefer_server_ciphers on;

        add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;

        include /etc/nginx/app_locations.conf;
    }
}
