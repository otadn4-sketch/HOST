worker_processes auto;
error_log /var/log/nginx/error.log warn;
pid /tmp/nginx.pid;

events { worker_connections 1024; }

http {
    include       /etc/nginx/mime.types;
    default_type  application/octet-stream;
    sendfile      on;
    server_tokens off;
    client_max_body_size ${CLIENT_MAX_BODY_SIZE};

    # Resolve Compose service names at request time. This avoids a startup
    # failure when Nginx starts before Docker's embedded DNS has registered
    # backend and frontend on the internal network.
    resolver 127.0.0.11 ipv6=off valid=10s;
    resolver_timeout 5s;

    proxy_hide_header Server;
    proxy_hide_header X-Powered-By;

    server {
        listen 80 default_server;
        server_name ${PUBLIC_HOST};
        return 301 https://$host$request_uri;
    }

    server {
        listen 443 ssl default_server;
        http2 on;
        server_name ${PUBLIC_HOST};

        set $backend_upstream http://backend:8000;
        set $frontend_upstream http://frontend:8080;

        ssl_certificate     ${TLS_CERT_PATH};
        ssl_certificate_key ${TLS_KEY_PATH};
        ssl_protocols       TLSv1.2 TLSv1.3;
        ssl_prefer_server_ciphers on;

        add_header X-Content-Type-Options nosniff always;
        add_header X-Frame-Options DENY always;
        add_header Referrer-Policy no-referrer always;
        add_header Permissions-Policy "geolocation=(), microphone=(), camera=()" always;
        add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;

        location = /api/health {
            proxy_pass $backend_upstream/api/health;
            proxy_set_header Host $host;
            proxy_set_header X-Forwarded-Proto https;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        }

        location /api/ {
            proxy_pass $backend_upstream;
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto https;
            proxy_request_buffering off;
            proxy_read_timeout 300s;
        }

        location / {
            proxy_pass $frontend_upstream;
            proxy_set_header Host $host;
            proxy_set_header X-Forwarded-Proto https;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        }
    }
}
